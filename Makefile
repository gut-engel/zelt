# zelt build tasks.  `make help` lists them.
#
# Signing material lives OUTSIDE the repository, in $(SIGNING_DIR):
#   zelt-release.jks       Android release keystore (RSA 4096, PKCS12)
#   keystore.properties    its passwords (read by android/app/build.gradle.kts)
#   update-signing.key     Ed25519 key that signs update manifests
# Back this directory up somewhere safe: without the keystore, existing Android
# installs can never be updated; without the update key, no app accepts updates.

SHELL       := /bin/bash
VERSION     := $(shell sed -n 's/^version: *\([^+]*\)+.*/\1/p' pubspec.yaml)
BUILD       := $(shell sed -n 's/^version: *[^+]*+\([0-9]*\).*/\1/p' pubspec.yaml)
SIGNING_DIR ?= $(HOME)/.config/zelt-signing
KEYSTORE    := $(SIGNING_DIR)/zelt-release.jks
KEYPROPS    := $(SIGNING_DIR)/keystore.properties
UPDATE_KEY  := $(SIGNING_DIR)/update-signing.key
KEYTOOL     ?= keytool
DIST        := dist/$(VERSION)
CORE        := packages/zelt_core
APKS        := build/app/outputs/flutter-apk

.PHONY: help deps analyze test check keys pubkey debug release android-debug android-release \
        linux-debug linux-release windows-release relay dist sign verify publish clean

help: ## list targets
	@grep -hE '^[a-z-]+:.*## ' $(MAKEFILE_LIST) | sed 's/:.*## /\t/' | expand -t 18

deps: ## fetch dependencies
	flutter pub get
	cd $(CORE) && dart pub get

analyze: deps ## static analysis
	flutter analyze
	cd $(CORE) && dart analyze

test: deps ## run all tests (core unit + multi-node end-to-end, then widget)
	cd $(CORE) && dart test
	flutter test

check: analyze test ## analyze + test

keys: $(KEYPROPS) $(UPDATE_KEY) pubkey ## create the release keystore and update key (once)

$(KEYPROPS):
	@mkdir -p $(SIGNING_DIR) && chmod 700 $(SIGNING_DIR)
	@test ! -e $(KEYSTORE) || { echo "$(KEYSTORE) exists but $(KEYPROPS) is missing; restore it from your backup"; exit 1; }
	@pw=$$(head -c 48 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 32); \
	$(KEYTOOL) -genkeypair -keystore $(KEYSTORE) -storetype PKCS12 -alias zelt \
	  -keyalg RSA -keysize 4096 -validity 10000 -dname "CN=zelt" \
	  -storepass "$$pw" -keypass "$$pw" -noprompt >/dev/null && \
	printf 'storeFile=%s\nstorePassword=%s\nkeyAlias=zelt\nkeyPassword=%s\n' "$(KEYSTORE)" "$$pw" "$$pw" > $@ && \
	chmod 600 $@ $(KEYSTORE) && echo "created $(KEYSTORE)"

$(UPDATE_KEY):
	@mkdir -p $(SIGNING_DIR) && chmod 700 $(SIGNING_DIR)
	cd $(CORE) && dart run bin/zelt_sign.dart keygen $(UPDATE_KEY) >/dev/null
	@echo "created $(UPDATE_KEY)"

pubkey: $(UPDATE_KEY) ## write the update key's PUBLIC half into the app
	@pub=$$(cd $(CORE) && dart run bin/zelt_sign.dart pubkey $(UPDATE_KEY) 2>/dev/null | tail -n1); \
	printf '// Generated by `make pubkey`. Public half of the release signing key:\n// apps install only updates whose manifest is signed by it.\nconst updatePublicKey = '"'"'%s'"'"';\n' "$$pub" > lib/app/update_key.dart; \
	echo "update public key: $$pub"

debug: android-debug linux-debug ## debug builds for Android and Linux

release: android-release linux-release ## signed release builds for Android and Linux

android-debug: deps ## Android debug APK
	flutter build apk --debug

android-release: deps $(KEYPROPS) ## Android release APKs (one per ABI), signed with the local keystore
	flutter build apk --release --split-per-abi

linux-debug: deps ## Linux debug bundle
	flutter build linux --debug

linux-release: deps ## Linux release bundle
	flutter build linux --release

windows-release: deps ## Windows release (needs a Windows host; CI builds it for releases)
	flutter build windows --release

relay: ## headless relay binary (build/relay/zelt_relay)
	@mkdir -p build/relay
	cd $(CORE) && dart compile exe bin/zelt_relay.dart -o ../../build/relay/zelt_relay

dist: release ## collect release files into dist/<version>/
	@rm -rf $(DIST) && mkdir -p $(DIST)
	cp $(APKS)/app-arm64-v8a-release.apk   $(DIST)/zelt-$(VERSION)-android-arm64.apk
	cp $(APKS)/app-armeabi-v7a-release.apk $(DIST)/zelt-$(VERSION)-android-armv7.apk
	cp $(APKS)/app-x86_64-release.apk      $(DIST)/zelt-$(VERSION)-android-x64.apk
	tar -C build/linux/x64/release/bundle -czf $(DIST)/zelt-$(VERSION)-linux-x64.tar.gz .
	@ls -la $(DIST)

sign: $(UPDATE_KEY) ## sign the update manifest for everything in dist/<version>/
	cd $(CORE) && dart run bin/zelt_sign.dart manifest $(UPDATE_KEY) ../../$(DIST) $(VERSION) $(BUILD) "zelt $(VERSION)"

verify: ## verify dist/<version>/ against the public key in the app
	@pub=$$(sed -n "s/^const updatePublicKey = '\(.*\)';/\1/p" lib/app/update_key.dart); \
	cd $(CORE) && dart run bin/zelt_sign.dart verify "$$pub" ../../$(DIST)

publish: ## test, build, tag, let CI build Windows, sign, create the GitHub release
	scripts/release.sh $(VERSION) $(BUILD)

clean: ## remove build output
	flutter clean
	rm -rf dist build/relay
